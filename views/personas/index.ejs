<%- include('../plantillas/header') %>
    <h1>Lista de Personas</h1>
    <a class="btn btn-primary" href="/personas/crear">Nueva Persona</a>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Ventas</th>
                <th>Acciones</th>
            </tr>

        </thead>
        <tbody>
            <% if (persona !==null){ persona.forEach(p=> {
                %>
                <tr>
                    <td>
                        <%= p.id %>
                    </td>
                    <td>
                        <%= p.nombre %>
                    </td>
                    <td>
                        <%= p.email %>
                    </td>
                    <td>
                        <%= p.venta.length %>
                    </td>
                    <td>
                        <a class="btn btn-edit" href="/personas/<%= p.id %>/editar">Editar</a>
                        <form action="/personas/<%= p.id %>?_method=DELETE" method="POST" style="display:inline"
                            onsubmit="return confirm('¿Eliminar esta persona?')">
                            <button class="btn btn-delete" type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
                <% })} %>
        </tbody>
    </table>
    <%- include('../plantillas/footer') %>