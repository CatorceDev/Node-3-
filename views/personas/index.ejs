<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Registro de Personas</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 700px;
            margin: 40px auto;
        }

        input {
            display: block;
            margin: 8px 0;
            padding: 8px;
            width: 100%;
        }

        button {
            padding: 10px 20px;
            background: #007bff;
            color: white;
            border: none;
            cursor: pointer;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        .ok {
            color: green;
        }

        .err {
            color: red;
        }
    </style>
</head>

<body>
    <h1>Registrar Persona</h1>
    <% if (mensaje) { %>
        <p class="ok">
            <%= mensaje %>
        </p>
        <% } %>
            <% if (error) { %>
                <p class="err">
                    <%= error %>
                </p>
                <% } %>
                    <form action="/registro" method="POST">
                        <input type="text" name="nombre" placeholder="Nombre" required>
                        <input type="text" name="apellido" placeholder="Apellido" required>
                        <input type="email" name="email" placeholder="Email" required>
                        <input type="number" name="edad" placeholder="Edad" required min="0" max="120">
                        <button type="submit">Guardar</button>
                    </form>
                    <h2>Personas registradas</h2>
                    <table>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Edad</th>
                        </tr>
                        <% personas.forEach(p=> { %>
                            <tr>
                                <td>
                                    <%= p.id %>
                                </td>
                                <td>
                                    <%= p.nombre %>
                                </td>
                                <td>
                                    <%= p.apellido %>
                                </td>
                                <td>
                                    <%= p.email %>
                                </td>
                                <td>
                                    <%= p.edad %>
                                </td>
                            </tr>
                            <% }) %>
                    </table>
</body>

</html>